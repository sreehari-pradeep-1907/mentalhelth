# Server port (Render sets this automatically)
PORT=3001

# Google Apps Script Web App URL (deploy your Apps Script and paste the URL here)
GOOGLE_APPS_SCRIPT_URL=

# Correct answers as a JSON string (must match quiz options in client/src/data/quizData.ts)
# Example: CORRECT_ANSWERS={"q1":"B","q2":"A","q3":"C","q4":"B","q5":"A"}
CORRECT_ANSWERS=
